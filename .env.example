# =============================================================================
# Plantilla de variables de entorno (.env.example)
# =============================================================================
# Copia este archivo a .env y define tus credenciales reales antes de iniciar:
#   cp .env.example .env
# =============================================================================

# --- Credenciales para la Base de Datos PostgreSQL ---
POSTGRES_DB=moodle_db
POSTGRES_USER=moodle_user
POSTGRES_PASSWORD=define_aqui_una_contraseña_segura_para_la_bd

# --- URL base de Moodle (en local: http://localhost:8080, en prod: https://tudominio.com) ---
MOODLE_WWWROOT=http://localhost:8080

# --- Credenciales para el Administrador de Moodle ---
MOODLE_USERNAME=admin_usuario
MOODLE_PASSWORD=DefineAquiTuContraseñaAdminSegura123*
MOODLE_ADMIN_EMAIL=admin@tuorganizacion.com

# --- Nombre del Sitio en Moodle ---
MOODLE_SITE_FULLNAME="Mi Academia / Institucion"
MOODLE_SITE_SHORTNAME="MiAcademia"

# --- Configuración API REST (Evaluador / Calificaciones automáticas) ---
MOODLE_API_BOT_USERNAME=nombre_usuario_bot
MOODLE_API_BOT_PASSWORD=DefineAquiTuContraseñaBotSegura123*
MOODLE_API_BOT_EMAIL=bot@tuorganizacion.com
MOODLE_API_SERVICE_NAME="Servicio Evaluador API"
MOODLE_API_SERVICE_SHORTNAME=evaluador_service
MOODLE_API_TOKEN=genera_un_token_alfanumerico_seguro_de_32_caracteres

# --- Datos Usuario Demo (Danie G. Krige) ---
DEMO_USER_FIRSTNAME=Danie G.
DEMO_USER_LASTNAME=Krige
DEMO_USER_COUNTRY=ZA
DEMO_USER_EMAIL=daniekrige@geoestadistica.rock
DEMO_USER_USERNAME=daniekrige@geoestadistica.rock
DEMO_USER_PASSWORD=DefineAquiLaContraseñaDelUsuarioDemo123*
